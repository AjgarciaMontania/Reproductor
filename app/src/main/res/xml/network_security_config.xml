<?xml version="1.0" encoding="utf-8"?>
<!--
  Muchas listas IPTV publicas todavia sirven por HTTP sin TLS.
  Se permite trafico en claro para poder reproducirlas.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
